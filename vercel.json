{
  "rewrites": [
    {
      "source": "/lantern/:slug/travelers-lullaby.html",
      "destination": "/travelers-lullaby.html"
    }
  ],
  "headers": [
    {
      "source": "/data/printables.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, OPTIONS"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/lantern/:slug/printables/:file*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, OPTIONS"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/print/:file*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, OPTIONS"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.mp3",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, OPTIONS"
        }
      ]
    },
    {
      "source": "/lantern/(.*)-lullaby.html",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, OPTIONS"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude-work": false,
      "lullaby-check": false,
      "lullaby-fresh": false,
      "native-peoples": false,
      "remember-this-and-story-lullaby": false
    }
  },
  "redirects": [
    {
      "source": "/lantern/:slug/printables/:file(story|story-christian)\\.pdf",
      "missing": [
        {
          "type": "header",
          "key": "origin",
          "value": "^(capacitor|ionic)://localhost$|^https?://localhost$"
        }
      ],
      "destination": "/printables.html?open=story-:slug",
      "permanent": false
    },
    {
      "source": "/lantern/:slug/printables/song.pdf",
      "missing": [
        {
          "type": "header",
          "key": "origin",
          "value": "^(capacitor|ionic)://localhost$|^https?://localhost$"
        }
      ],
      "destination": "/printables.html?open=song-:slug",
      "permanent": false
    },
    {
      "source": "/store",
      "destination": "https://app.littlescripturetravelers.com/store/",
      "permanent": false
    },
    {
      "source": "/store/:path*",
      "destination": "https://app.littlescripturetravelers.com/store/:path*",
      "permanent": false
    }
  ]
}
