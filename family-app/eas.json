{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "APP_NAME": "Lewis Family"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
