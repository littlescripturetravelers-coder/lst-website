{
  "expo": {
    "name": "Lewis Family",
    "slug": "lewis-family",
    "scheme": "lewisfamily",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "extra": {
      "appName": "Lewis Family",
      "paywallEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.lewisfamily.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCalendarsFullAccessUsageDescription": "Shows and adds family events and reminders to your Apple Calendar.",
        "NSRemindersFullAccessUsageDescription": "Keeps family reminders in sync with Apple Reminders so Siri can use them.",
        "NSSiriUsageDescription": "Lets you add reminders and hear today\u2019s plan with Siri.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.siri": true,
        "com.apple.security.application-groups": [
          "group.com.lewisfamily.app"
        ]
      }
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "Family calendar",
          "remindersPermission": "Family reminders"
        }
      ],
      "./ios-intents/with-app-intents.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
