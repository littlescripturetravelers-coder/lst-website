  "audio": [
   {
    "id": "l1",
    "kind": "voice",
    "speaker": "narrator",
    "delivery": "[warm]",
    "text": "One golden evening, four friends were building the tallest block tower in the whole playroom."
   },
   {
    "id": "l2",
    "kind": "voice",
    "speaker": "scout",
    "delivery": "[excited]",
    "text": "Mine has a window! And a bug door!"
   },
   {
    "id": "l3",
    "kind": "voice",
    "speaker": "beau",
    "delivery": "[quietly]",
    "text": "Oh no. It fell down. All of it."
   },
   {
    "id": "l4",
    "kind": "voice",
    "speaker": "wren",
    "delivery": "[gently]",
    "text": "Pause and ponder — what a wonder! Let's open the Travel Chest."
   },
   {
    "id": "l5",
    "kind": "voice",
    "speaker": "narrator",
    "text": "Long ago, a wicked king cut up Jeremiah's scroll and burned it in the fire."
   },
   {
    "id": "l6",
    "kind": "voice",
    "speaker": "narrator",
    "text": "But the word of the Lord came again. Baruch took another roll and wrote every word again."
   },
   {
    "id": "l7",
    "kind": "voice",
    "speaker": "beau",
    "delivery": "[brave]",
    "text": "Big heart, brave start! I can build it again, from the very bottom."
   },
   {
    "id": "l8",
    "kind": "voice",
    "speaker": "narrator",
    "text": "Something worth making is worth making again. Goodnight, little travelers."
   },
